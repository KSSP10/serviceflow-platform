set -e

if [ -z "$MAVEN_HOME" ]; then
  if [ -n "$JAVA_HOME" ]; then
    JAVA_HOME="$JAVA_HOME"
  else
    echo "JAVA_HOME is not set" >&2
    exit 1
  fi
fi

if [ -z "$MAVEN_VERSION" ]; then
  MAVEN_VERSION="3.9.6"
fi

DOWNLOAD_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MAVEN_VERSION/apache-maven-$MAVEN_VERSION-bin.zip"

if [ ! -x "$MAVEN_HOME/bin/mvn" ]; then
  TMP_DIR=$(mktemp -d)
  curl -fsSL "$DOWNLOAD_URL" -o "$TMP_DIR/apache-maven.zip"
  unzip -q "$TMP_DIR/apache-maven.zip" -d "$TMP_DIR"
  mkdir -p "$MAVEN_HOME"
  cp -R "$TMP_DIR/apache-maven-$MAVEN_VERSION"/* "$MAVEN_HOME"
  rm -rf "$TMP_DIR"
fi

exec "$MAVEN_HOME/bin/mvn" "$@"
